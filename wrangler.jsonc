{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarot-by-satakshi",
  "main": "worker/index.ts",
  // Matches the installed workerd runtime (1.20261023.x).
  "compatibility_date": "2026-10-23",
  "assets": {
    // Next.js static export output.
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only API requests run the Worker; every page is a free static asset.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
  // D1, R2, secrets and the cron trigger are added in phase 4 (backend).
}
