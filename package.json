{
  "name": "tarot-by-satakshi",
  "version": "0.1.0",
  "private": true,
  "description": "Tarot by Satakshi: website and booking platform (Next.js static export + Cloudflare Worker API, D1, R2)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-services.mjs && next build && node scripts/fix-export-segments.mjs && node scripts/csp.mjs",
    "preview": "npm run build && wrangler dev",
    "worker:dev": "wrangler dev",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "lint": "oxlint",
    "format": "prettier --write .",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^6.0.2",
    "@marsidev/react-turnstile": "^1.6.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "lenis": "^1.3.27",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "resend": "^6.35.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "zod": "$zod",
      "sharp": "^0.35.5",
      "undici": "^7.30.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261023.1": true
  }
}
